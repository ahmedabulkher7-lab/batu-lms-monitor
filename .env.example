# بيانات الدخول لمنصة جامعة برج العرب التكنولوجية (BATU LMS)
# يمكنك كتابة الرقم الأكاديمي فقط (مثل 2213001) أو البريد الكامل (2213001@batechu.com)
BATU_ACADEMIC_ID=
BATU_PASSWORD=

# إعدادات بوت تيليجرام للتنبيهات الفورية
# احصل على التوكن من @BotFather على تيليجرام
TELEGRAM_BOT_TOKEN=
# يمكنك معرفة الـ Chat ID بتشغيل: node monitor.mjs --get-chat-id
TELEGRAM_CHAT_ID=

# إرسال ملخص يومي حتى لو لم ينزل كويز جديد (true أو false)
SEND_DAILY_DIGEST=true
